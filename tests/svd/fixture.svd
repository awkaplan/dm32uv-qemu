<?xml version="1.0" encoding="utf-8"?>
<!--
  SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
  Copyright (c) 2026 Alex Kaplan

  Synthetic CMSIS-SVD for tests/svd/test_gen.py. Invented names; it is not
  derived from HR_C7000-DM32.svd. Each block exercises one generator rule.
-->
<device schemaVersion="1.1">
  <name>TESTDEV</name>
  <version>1.0</version>
  <description>Synthetic device for gen_svd_regs.py tests</description>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x000000aa</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>TESTA</name>
      <description>Covers the register-level rules</description>
      <baseAddress>0x40000000</baseAddress>
      <access>read-only</access>
      <addressBlock>
        <offset>0</offset>
        <size>0x100</size>
        <usage>registers</usage>
      </addressBlock>
      <interrupt>
        <name>TESTA_IRQ</name>
        <value>5</value>
      </interrupt>
      <registers>
        <!-- Inherits size, access (peripheral read-only), reset (device 0xaa). -->
        <register>
          <name>STAT</name>
          <addressOffset>0x00</addressOffset>
          <fields>
            <field>
              <name>BUSY</name>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>ERR</name>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <!-- Register access overrides the peripheral's; explicit reset. -->
        <register>
          <name>CTRL</name>
          <addressOffset>0x04</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000010</resetValue>
          <fields>
            <field>
              <name>EN</name>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>MODE</name>
              <bitRange>[3:1]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>STATUS</name>
              <bitOffset>4</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
            </field>
            <field>
              <name>LEVEL</name>
              <bitOffset>6</bitOffset>
              <bitWidth>2</bitWidth>
            </field>
          </fields>
        </register>
        <!-- Field-level oneToClear, oneToSet and readAction clear. -->
        <register>
          <name>INT_ST</name>
          <addressOffset>0x08</addressOffset>
          <access>read-write</access>
          <fields>
            <field>
              <name>FLAG_A</name>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field>
              <name>FLAG_B</name>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <modifiedWriteValues>oneToSet</modifiedWriteValues>
            </field>
            <field>
              <name>FLAG_C</name>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <readAction>clear</readAction>
            </field>
            <field>
              <name>FLAG_D</name>
              <bitRange>[4:3]</bitRange>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
          </fields>
        </register>
        <!-- Register-level readAction clear, explicit reset 0. -->
        <register>
          <name>RC_REG</name>
          <addressOffset>0x0c</addressOffset>
          <access>read-write</access>
          <readAction>clear</readAction>
          <resetValue>0x00000000</resetValue>
        </register>
        <!-- 8-bit register with a read-only low nibble. -->
        <register>
          <name>BYTE</name>
          <addressOffset>0x10</addressOffset>
          <size>8</size>
          <access>read-write</access>
          <resetValue>0xa5</resetValue>
          <fields>
            <field>
              <name>LOW</name>
              <bitRange>[3:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <!-- Two registers at offset 0x20; the second is the alternate. -->
        <register>
          <name>DATA_A</name>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
          <resetValue>0x00000011</resetValue>
        </register>
        <register>
          <name>DATA_B</name>
          <alternateRegister>DATA_A</alternateRegister>
          <addressOffset>0x20</addressOffset>
          <access>read-write</access>
        </register>
        <!-- Cluster with dim 3: CH0_CFG, CH0_CNT, CH1_CFG, ... -->
        <cluster>
          <name>CH[%s]</name>
          <description>Channel block</description>
          <addressOffset>0x40</addressOffset>
          <dim>3</dim>
          <dimIncrement>0x10</dimIncrement>
          <access>read-only</access>
          <resetValue>0x00000005</resetValue>
          <register>
            <name>CFG</name>
            <addressOffset>0x00</addressOffset>
          </register>
          <register>
            <name>CNT</name>
            <addressOffset>0x04</addressOffset>
            <access>read-write</access>
            <resetValue>0x00000000</resetValue>
          </register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral derivedFrom="TESTA">
      <name>TESTB</name>
      <baseAddress>0x50000000</baseAddress>
      <interrupt>
        <name>TESTB_EVT</name>
        <value>9</value>
      </interrupt>
    </peripheral>
  </peripherals>
</device>
